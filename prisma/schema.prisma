generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid()) // Unique identifier for each user
  username  String // The user's name
  email     String    @unique // Unique email for login and communication
  password  String // Hashed password for security
  createdAt DateTime  @default(now()) // Timestamp when the user was created
  updatedAt DateTime  @updatedAt // Timestamp updated whenever the record is modified
  deletedAt DateTime? // Optional field for soft deletion

  // Add the following relation fields
  createdGroups Group[] // Groups created by the user
  groupMembers  GroupMember[] // Group memberships of the user
  sentFriendRequests     FriendRequest[]    @relation("SentRequests")       // Friend requests sent by user
  receivedFriendRequests FriendRequest[]    @relation("ReceivedRequests")   // Friend requests received by user
  friendships1           Friendship[]       @relation("FriendshipUser1")    // Friendships where user is user1
  friendships2           Friendship[]       @relation("FriendshipUser2")    // Friendships where user is user2
  paidExpenses           Expense[]          @relation("PaidExpenses")       // Expenses paid by user
  expenseSplits  ExpenseSplit[] // Splits of expenses where user is involved
  lending    Balance[] @relation("lends")
  borrowing  Balance[] @relation("borrows")
   settlementsAsPayer    Settlement[] @relation("settles")
  settlementsAsReceiver Settlement[] @relation("receivesSettlement")

}

model Group {
  id          String        @id @default(uuid())
  name        String
  description String?
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdById String
  members     GroupMember[]
  expenses    Expense[]
  balances    Balance[]     
   settlements Settlement[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
}


model GroupMember {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  group     Group     @relation(fields: [groupId], references: [id])
  groupId   String
  joinedAt  DateTime  @default(now())
  deletedAt DateTime?

  @@unique([userId, groupId])
}


model FriendRequest {
  id          String    @id @default(uuid())
  sender      User      @relation("SentRequests", fields: [senderId], references: [id])
  senderId    String
  receiver    User      @relation("ReceivedRequests", fields: [receiverId], references: [id])
  receiverId  String
  status      RequestStatus @default(PENDING)    // e.g., "pending", "accepted", "declined"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Friendship {
  id      String   @id @default(uuid())
  user1   User     @relation("FriendshipUser1", fields: [user1Id], references: [id])
  user1Id String
  user2   User     @relation("FriendshipUser2", fields: [user2Id], references: [id])
  user2Id String
  createdAt  DateTime @default(now())

  @@unique([user1Id, user2Id])
}

model Expense {
  id          String        @id @default(uuid())
  description String
  amount      Decimal
  paidBy      User          @relation("PaidExpenses", fields: [paidById], references: [id])
  paidById    String
  group       Group         @relation(fields: [groupId], references: [id])
  groupId     String
  splits      ExpenseSplit[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ExpenseSplit {
  id         String   @id @default(uuid())
  expense    Expense  @relation(fields: [expenseId], references: [id])
  expenseId  String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  share      Decimal
  createdAt  DateTime @default(now())
}

model Balance {
  id         String   @id @default(uuid())
  group      Group    @relation(fields: [groupId], references: [id])
  groupId    String
  lender     User     @relation("lends", fields: [lenderId], references: [id])
  lenderId   String
  borrower   User     @relation("borrows", fields: [borrowerId], references: [id])
  borrowerId String
  amount     Decimal
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([groupId, lenderId, borrowerId])
}
// prisma/schema.prisma
model Settlement {
  id          String   @id @default(uuid())
  group       Group    @relation(fields: [groupId], references: [id])
  groupId     String
  paidBy      User     @relation("settles", fields: [paidById], references: [id])
  paidById    String
  paidTo      User     @relation("receivesSettlement", fields: [paidToId], references: [id])
  paidToId    String
  amount      Decimal
  createdAt   DateTime @default(now())
}
enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}